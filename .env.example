# Model (Vercel deployments can use project OIDC instead of an API key).
AI_GATEWAY_API_KEY=
EVE_MODEL=openai/gpt-5.4

# Public HTTPS origin for artifact links and approval cards.
PUBLIC_APP_URL=

# Exactly one authorized iMessage owner, including the imessage: prefix.
PHOTON_ALLOWED_PRINCIPALS=imessage:+15551234567

# Your own Photon connector in Vercel Connect; never reuse Adaam's connector.
PHOTON_CONNECTOR_ID=

# Optional direct Photon credentials instead of Vercel Connect.
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Coinbase Advanced Trade API key for a dedicated spot portfolio.
# Enter secrets directly into encrypted deployment settings, never into chat.
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=
COINBASE_ALLOWED_PRINCIPALS=imessage:+15551234567

# One dedicated Redis database: TLS URL for Chat SDK, REST URL/token for state.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# One dedicated PUBLIC Vercel Blob store. Artifacts must contain public data only.
BLOB_READ_WRITE_TOKEN=
