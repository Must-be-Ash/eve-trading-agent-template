# Model access. Hosted Vercel can use project OIDC for AI Gateway.
AI_GATEWAY_API_KEY=
EVE_MODEL=openai/gpt-5.4
PUBLIC_APP_URL=

# One owner, many isolated conversations. Replace the illustrative number.
PHOTON_ALLOWED_PRINCIPALS=imessage:+15551234567
COINBASE_ALLOWED_PRINCIPALS=imessage:+15551234567
EVE_DEPLOYMENT_OWNER_ID=owner
# Generate independently: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
EVE_OWNER_ALIAS_HMAC_SECRET=
EVE_WORKSPACE_RUNTIME_AUTH_SECRET=
EVE_HYBRID_EVIDENCE_AUTH_SECRET=

# Your own Photon Connect connector OR all three direct credentials.
PHOTON_CONNECTOR_ID=
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Official Coinbase CLI credentials for view/trade on your own spot portfolio.
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=

# One NEW dedicated Redis database; TLS for Chat SDK, REST for durable stores.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Separate Blob stores: public reports/media and PRIVATE worker evidence.
BLOB_READ_WRITE_TOKEN=
EVE_HYBRID_EVIDENCE_READ_WRITE_TOKEN=

# Session manager/configuration are available; background execution is initially off.
EVE_WORKSPACE_STATE_ENABLED=1
EVE_WORKSPACE_MONITOR_WRITES_ENABLED=1
EVE_STRATEGY_PACK_CATALOG_ENABLED=1
EVE_STRATEGY_PACK_RUNTIME_ENABLED=1
EVE_STRATEGY_PACK_MUTATIONS_ENABLED=1
EVE_WORKSPACE_DISPATCH_ENABLED=0
EVE_WORKSPACE_PAID_RESEARCH_ENABLED=0
EVE_PHOTON_WORKSPACE_ALERTS_ENABLED=0
EVE_WORKSPACE_SOURCE_EVENTS_ENABLED=0
EVE_STRATEGY_PACK_MANAGED_DISPATCH_ENABLED=0
EVE_PUBLIC_SOURCE_ACQUISITION_ENABLED=0
EVE_PUBLIC_SOURCE_PROJECTIONS_ENABLED=0
EVE_X_PUBLIC_STATEMENT_SOURCE_ENABLED=0
EVE_X_MONITOR_EXECUTION_ENABLED=0
EVE_HYBRID_EVIDENCE_ENABLED=0
EVE_HYBRID_SEMANTIC_REASONING_ENABLED=0

# Optional X monitoring setup. No accounts, topics, or watchlists are preconfigured.
X_BEARER_TOKEN=
EXA_API_KEY=
# 32 random bytes encoded as standard base64, separate from the HMAC secrets.
EVE_PUBLIC_COMMENTARY_EVIDENCE_KEY_BASE64=
EVE_PUBLIC_COMMENTARY_EVIDENCE_KEY_REFERENCE=kms://template/evidence-v1
# Separate optional corroboration step; the research lane can still use Exa when off.
EVE_EXA_CORROBORATION_ENABLED=0

# Match the playbook's pinned model contracts before enabling background work.
EVE_HYBRID_FAST_MODEL_ID=google/gemini-3.7-flash
EVE_HYBRID_FAST_MODEL_REASONING=low
EVE_HYBRID_FRONTIER_MODEL_ID=openai/gpt-5.4-mini
EVE_HYBRID_FRONTIER_MODEL_REASONING=high
EVE_STRATEGY_PACK_WORKER_MODEL_ID=openai/gpt-5.4-mini

# Deployment admission caps, in addition to each session's explicit budget.
# These inherited SOURCE_RECOVERY names also govern semantic child workers.
EVE_WORKSPACE_GLOBAL_CONCURRENT_WORKERS=2
EVE_WORKSPACE_GLOBAL_RUNS_PER_DAY=100
EVE_HYBRID_SOURCE_RECOVERY_MODEL_IDS=google/gemini-3.7-flash,openai/gpt-5.4-mini
EVE_HYBRID_SOURCE_RECOVERY_CONCURRENT_WORKERS=2
EVE_HYBRID_SOURCE_RECOVERY_INPUT_TOKENS_PER_DAY=200000
EVE_HYBRID_SOURCE_RECOVERY_OUTPUT_TOKENS_PER_DAY=100000
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_CALL=1.00
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_DAY=10.00
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_MONTH=50.00
